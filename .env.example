MYSQL_DATABASE=silatsense
MYSQL_USER=silatsense
MYSQL_PASSWORD=local-development-password
MYSQL_ROOT_PASSWORD=local-root-password
DATABASE_URL=mysql+pymysql://silatsense:local-development-password@127.0.0.1:13307/silatsense
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Recovery stays unavailable until SMTP is explicitly configured.
MAIL_ADAPTER=disabled
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
# SMTP_USERNAME and SMTP_PASSWORD: supply privately when required by provider.
API_PORT=8000
POSE_MODEL_PATH=artifacts/pose/pose_landmarker_lite.task
REFERENCE_ROOT=artifacts/reference_profiles
SAMPLE_FPS=2
MAX_VIDEO_MB=100
MAX_VIDEO_SECONDS=60
MEDIA_ROOT=.data/media
MEDIA_RETENTION_HOURS=24
UPLOAD_QUOTA_MB=500
MAX_PENDING_SESSIONS=2
UPLOAD_RESERVATION_SECONDS=300
VIDEO_PROBE_TIMEOUT_SECONDS=30
MAX_VIDEO_DIMENSION=3840
MAX_VIDEO_SHORT_DIMENSION=2160
PROCESS_MEMORY_MB=2048
WORKER_CONCURRENCY=1
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_JOB_TIMEOUT_SECONDS=120
WORKER_MAX_ATTEMPTS=3
CLEANUP_INTERVAL_SECONDS=60
CLEANUP_BATCH_SIZE=100
ORPHAN_GRACE_SECONDS=3600
