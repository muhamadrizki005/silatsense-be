# Setup utama: MySQL native lokal. Buat database dan gunakan user MySQL milikmu.
# Ganti username/password; URL-encode karakter khusus dalam password URL.
# File ini template: salin ke .env hanya untuk checkout baru.
DATABASE_URL=mysql+pymysql://silatsense:replace-with-your-local-password@127.0.0.1:3306/silatsense
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:3000
# Gunakan true pada deployment HTTPS; false untuk HTTP lokal.
COOKIE_SECURE=false

# Email opsional. Auth biasa tetap berjalan ketika adapter disabled.
# Untuk verifikasi/reset email: isi SMTP, gunakan smtp dan STARTTLS.
MAIL_ADAPTER=disabled
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
AUTH_ATTEMPTS_PER_15_MINUTES=10
AUTH_IP_REQUESTS_PER_15_MINUTES=120
SIGNUP_IP_REQUESTS_PER_HOUR=20

# API_PORT hanya dipakai Compose. Native: uvicorn ... --port 8001.
API_PORT=8001

# Model pose diunduh terpisah dan tidak dimasukkan Git.
POSE_MODEL_PATH=artifacts/pose/pose_landmarker_lite.task
REFERENCE_ROOT=artifacts/reference_profiles
SAMPLE_FPS=2

# Batas dan storage lokal: API, worker, cleanup memakai DB dan MEDIA_ROOT sama.
# Gunakan path absolut jika proses dijalankan dari direktori berbeda.
MAX_VIDEO_MB=100
MAX_VIDEO_SECONDS=60
MEDIA_ROOT=.data/media
MEDIA_RETENTION_HOURS=24
UPLOAD_QUOTA_MB=500
MAX_PENDING_SESSIONS=2
UPLOAD_RESERVATION_SECONDS=300
VIDEO_PROBE_TIMEOUT_SECONDS=30
MAX_VIDEO_DIMENSION=3840
MAX_VIDEO_SHORT_DIMENSION=2160
PROCESS_MEMORY_MB=2048

# Worker dijalankan terpisah: python -m scripts.worker.
WORKER_CONCURRENCY=1
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_JOB_TIMEOUT_SECONDS=120
WORKER_MAX_ATTEMPTS=3

# Cleanup dijalankan terpisah: python -m scripts.cleanup_media.
CLEANUP_INTERVAL_SECONDS=60
CLEANUP_BATCH_SIZE=100
ORPHAN_GRACE_SECONDS=3600

# Khusus Docker Compose opsional; diabaikan aplikasi native.
# Compose mengganti DATABASE_URL ke host internal db:3306 dan memakai volume sendiri.
# Ganti password ini sebelum memakai Compose; bukan kredensial MySQL native/Filess.
MYSQL_DATABASE=silatsense
MYSQL_USER=silatsense
MYSQL_PASSWORD=replace-with-a-separate-docker-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-docker-root-password
